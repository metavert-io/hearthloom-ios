# Xcode / build
build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate

# Generated by xcodegen — regenerate with `xcodegen generate`
Hearthloom.xcodeproj/

# SPM
.build/
.swiftpm/

# macOS
.DS_Store

# Secrets — never commit tokens or connection dumps
*.pat
secrets.local.*
VIBECTL.md

# Opt-in feature overlays for Scripts/generate.sh (local, per-developer).
# The .example templates ARE committed; the live overlays are not.
project.sentry.yml
.xcodegen-composed.yml
.sentryclirc

# Per-developer signing (Team ID, bundle ID). The .example template is committed.
Config/*.local.xcconfig

# Private work notes stay on disk and out of the repo; CLAUDE.local.md
# (also ignored) indexes them.
CLAUDE.local.md
NEXTSTEPS*.md
*-TASK.md
local/
